# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Strava (create an app at https://www.strava.com/settings/api) ---
# "Authorization Callback Domain" in Strava must be the host of PUBLIC_URL (e.g. localhost or coach.home.lan)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8000

# --- Optional ---
COACH_MODEL=claude-sonnet-5-5
TZ=America/New_York
# If set, the UI is protected with HTTP basic auth (any username, this password)
APP_PASSWORD=
# Background Strava sync interval (minutes, 0 disables) and automatic weekly plan review
SYNC_INTERVAL_MIN=30
AUTO_ADJUST=true
COACH_DB=/data/coach.db
