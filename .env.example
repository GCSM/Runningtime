# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Strava: ONE app for the whole server; each user just taps "Connect with Strava" ---
# Create the app at https://www.strava.com/settings/api. Its "Authorization Callback Domain" must be the host you browse to
# (e.g. coach.lan: just the host, no http://, no port). New Strava apps allow 1 athlete; set the limit Strava gave yours.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ATHLETE_LIMIT=10
PUBLIC_URL=http://localhost:8000

# --- Optional ---
COACH_MODEL=claude-sonnet-5-5
# Thinking depth/cost: low | medium | high. medium is plenty for plans; low is cheapest.
COACH_EFFORT=medium
# Chat uses the cheapest model at low effort; messages per user per rolling 24h bound the cost.
COACH_CHAT_MODEL=claude-haiku-5-5
CHAT_MESSAGES_PER_DAY=40
TZ=America/New_York
# LXC/systemd install only: the port the app listens on. 80 means URLs need no :port. (Docker uses its own port mapping.)
COACH_PORT=80

# Accounts: anyone who can reach the app can sign up unless you restrict it.
# Set INVITE_CODE to require a code at signup, or ALLOW_SIGNUPS=false to close signups.
ALLOW_SIGNUPS=true
INVITE_CODE=
# Background Strava sync interval (minutes, 0 disables) and automatic weekly plan review
SYNC_INTERVAL_MIN=30
AUTO_ADJUST=true
COACH_DB=/data/coach.db

# Behind a reverse proxy: the proxy's IP, so per-IP login throttling sees real client addresses.
# FORWARDED_ALLOW_IPS=10.0.0.5
