# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Strava ---
# Recommended: leave these blank. Each user enters their OWN Strava app (Client ID/Secret) on their Me page, so each
# account uses its own app and Strava's per-app athlete limit isn't shared. Fill these only to offer one shared app.
# Either way, the app's "Authorization Callback Domain" in Strava must be the host of PUBLIC_URL.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8000

# --- Optional ---
COACH_MODEL=claude-sonnet-5-5
# Thinking depth/cost: low | medium | high. medium is plenty for plans; low is cheapest.
COACH_EFFORT=medium
TZ=America/New_York
# Accounts: anyone who can reach the app can sign up unless you restrict it.
# Set INVITE_CODE to require a code at signup, or ALLOW_SIGNUPS=false to close signups.
ALLOW_SIGNUPS=true
INVITE_CODE=
# Background Strava sync interval (minutes, 0 disables) and automatic weekly plan review
SYNC_INTERVAL_MIN=30
AUTO_ADJUST=true
COACH_DB=/data/coach.db

# Behind a reverse proxy: the proxy's IP, so per-IP login throttling sees real client addresses.
# FORWARDED_ALLOW_IPS=10.0.0.5
